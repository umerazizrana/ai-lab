# Environment / secrets
.env
.env.*
docker-compose/.env
docker-compose/.env.*
*.key
*.pem
*.crt
secrets/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Data — ignore contents but keep .dvc pointers and inner .gitignore
data/raw/*
!data/raw/.gitignore
!data/raw/*.dvc
data/processed/*
!data/processed/.gitignore
!data/processed/*.dvc
data/embeddings/*
!data/embeddings/.gitignore
!data/embeddings/*.dvc

# Models
models/*
!models/.gitignore
!models/*.dvc

# DVC local cache / local remote
.dvc/cache/
.dvc/tmp/
dvc-storage/

# ML artifacts
mlruns/
mlartifacts/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# IDE
.vscode/
.idea/
